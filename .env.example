# Optional public contact identifier sent to sharedmobility.ch.
# This is not a secret.
SHAREDMOBILITY_AUTH_EMAIL=swiss-scooters@plhery.com

# Shared Worker-to-origin credential, required for production cache/proxy use.
# Configure the SAME random value (32+ characters) as an encrypted Worker secret
# and a Coolify cache environment secret. Leave unset for local Next.js dev.
# SCOOTER_SNAPSHOT_API_TOKEN=
